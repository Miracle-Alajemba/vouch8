# Vouch8 Web & Faucet Environment Variables

# ==============================================================================
# Faucet Server Configuration (Keep private key secret - never prefix with VITE_)
# ==============================================================================
# Private key of a wallet funded with test tUSD8 and tQDAY gas on QDay Aevum Testnet (Chain ID 44005).
# The faucet server route (/api/faucet) sends 10 tUSD8 per claim with a 24-hour per-address cooldown.
FAUCET_PRIVATE_KEY=

# Optional custom RPC URL for QDay Aevum (defaults to https://rpc-test.qday.info)
AEVUM_RPC_URL=https://rpc-test.qday.info

# ==============================================================================
# Client Deployed Contract Addresses (QDay Aevum Testnet)
# ==============================================================================
VITE_REGISTRY_ADDRESS=0x8EA1be949E6FB94f5D0c110D216E06Cdb328D346
VITE_ESCROW_ADDRESS=0xDc2dD9C095a9EfB8526A9Afc752398dD79aAd8dA
VITE_VAULT_ADDRESS=0x15Bc8eB8e182B4961ace0F0ebDB2f9eB20AaC629
